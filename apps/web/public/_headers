/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

/login
  X-Robots-Tag: noindex, nofollow

/signup
  X-Robots-Tag: noindex, nofollow

/forgot-password
  X-Robots-Tag: noindex, nofollow

/update-password
  X-Robots-Tag: noindex, nofollow

/auth/*
  X-Robots-Tag: noindex, nofollow

/app
  X-Robots-Tag: noindex, nofollow

/app/*
  X-Robots-Tag: noindex, nofollow

/spa.html
  X-Robots-Tag: noindex, nofollow

/spa
  X-Robots-Tag: noindex, nofollow

/service-worker.js
  Cache-Control: no-cache

/pwa/cache-policy.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/downloads/zoption-android-2.0.0.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="zoption-android-2.0.0.apk"
  Cache-Control: public, max-age=31536000, immutable

/downloads/zoption-android-2.0.0.apk.sha256
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: attachment; filename="zoption-android-2.0.0.apk.sha256"
  Cache-Control: public, max-age=31536000, immutable

/downloads/latest.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-cache
