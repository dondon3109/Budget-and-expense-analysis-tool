# Copy to apps/api/.dev.vars for local Worker development.
# Never commit a real provider key or expose it through VITE_* variables.
# Public Worker-side Supabase key used by readiness and account reauthentication. It must match
# SUPABASE_URL in the active Wrangler config and be an sb_publishable_ or legacy anon key.
SUPABASE_PUBLISHABLE_KEY=
# Optional local development user UUID for dummy token bypass. Defaults to 00000000-0000-4000-8000-000000000001.
DEV_USER_ID=
# Local-only authentication shortcut, default off. Set to "true" only to let a loopback client
# authenticate with the dummy-dev-access-token bearer as DEV_USER_ID. Never set it in a deployed
# environment: it would arm an authentication bypass for anyone who can reach that host.
DEV_ACCESS_TOKEN_ENABLED=
# Optional provider timeout override in milliseconds (default 12000; recommended 30000 in dev).
ASSISTANT_PROVIDER_TIMEOUT_MS=30000
# Ceiling for one live voice socket in milliseconds (default 900000). The server closes the
# socket cleanly at the ceiling so a single connection cannot run up unbounded provider cost.
ASSISTANT_VOICE_STREAM_TIMEOUT_MS=

# Optional local/CI offline assistant. Set to `stub` to route every assistant turn through a
# deterministic in-process provider (tool loop included) with no provider key and no network
# access. Ignored whenever POSTHOG_AI_ENVIRONMENT is production.
ASSISTANT_PROVIDER=

DEEPSEEK_API_KEY=

# Optional local-only alternative to DeepSeek (Google AI Studio). An active provider
# config for gemini is still needed in D1; the key alone does not switch providers.
GEMINI_API_KEY=

# Required for spoken assistant replies. Voice recording and Cloudflare transcription can still
# run without it, but the UI will keep replies text-only until this server-side key is configured.
FISH_AUDIO_API_KEY=

# Optional server-side, metadata-only PostHog AI Observability. Keep disabled unless a project
# token is supplied; never expose this token through VITE_* browser variables.
POSTHOG_PROJECT_TOKEN=

# Encrypted provider credential storage. Generate with: openssl rand -base64 32
# Must match the Worker secret PROVIDER_CREDENTIAL_ENCRYPTION_KEY in preview/production.
# The key never lives in D1; only ciphertext does.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# PayPal and Dodo Payments are the subscription providers. Keep the client secret and webhook ID
# in this ignored file or Worker secrets; plan IDs and environment are non-secret.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PRO_MONTHLY_PLAN_ID=
PAYPAL_PRO_ANNUAL_PLAN_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Dodo Payments (merchant of record). Product IDs start with pdt_ and environment is
# test_mode or live_mode; the API key and the whsec_ webhook signing key are secrets.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRO_MONTHLY_PRODUCT_ID=
DODO_PRO_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# Resend transactional email (sponsored-seat invitations). Verify the sender domain in
# Resend and keep the API key in this ignored file or a `wrangler secret put` value.
RESEND_API_KEY=
