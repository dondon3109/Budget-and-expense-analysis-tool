# Copy to apps/api/.dev.vars for local Worker development.
# Never commit a real provider key or expose it through VITE_* variables.
# Public Worker-side Supabase key used by readiness and account reauthentication. It must match
# SUPABASE_URL in the active Wrangler config and be an sb_publishable_ or legacy anon key.
SUPABASE_PUBLISHABLE_KEY=

DEEPSEEK_API_KEY=

# PayPal is the active subscription provider. Keep the client secret and webhook ID
# in this ignored file or Worker secrets; plan IDs and environment are non-secret.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PRO_MONTHLY_PLAN_ID=
PAYPAL_PRO_ANNUAL_PLAN_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Resend transactional email (sponsored-seat invitations). Verify the sender domain in
# Resend and keep the API key in this ignored file or a `wrangler secret put` value.
RESEND_API_KEY=
