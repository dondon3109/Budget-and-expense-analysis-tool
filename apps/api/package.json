{
  "name": "@zoption/api",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:lan": "wrangler dev --ip 0.0.0.0 --port 8787",
    "dev:e2e": "wrangler dev --config wrangler.e2e.jsonc --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. --project api"
  },
  "dependencies": {
    "@zoption/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "wrangler": "^4.147.0"
  }
}
