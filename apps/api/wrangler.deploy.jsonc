{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budget-expense-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "migrations": [{ "tag": "v1-rate-limit", "new_sqlite_classes": ["RateLimitDurableObject"] }],
  "triggers": {
    "crons": ["*/5 * * * *", "17 3 * * *", "17 4 * * *"],
  },
  "env": {
    "preview": {
      "name": "budget-expense-api-preview",
      "ai": {
        "binding": "AI",
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "triggers": {
        "crons": ["*/5 * * * *", "17 3 * * *"],
      },
      "durable_objects": {
        "bindings": [{ "name": "RATE_LIMIT", "class_name": "RateLimitDurableObject" }],
      },
      "r2_buckets": [
        { "binding": "AVATARS", "bucket_name": "zoption-avatars-preview" },
        { "binding": "RECEIPTS", "bucket_name": "zoption-receipts-preview" },
      ],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "budget-expense-jobs-preview" }],
        "consumers": [
          {
            "queue": "budget-expense-jobs-preview",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "budget-expense-preview",
          "database_id": "edff68e8-49a2-4c35-a976-e6779592546e",
          "migrations_dir": "../../db/migrations",
        },
      ],
      "vars": {
        "ALLOWED_ORIGINS": "https://clarity-budget-preview.pages.dev,https://codex-webapp.clarity-budget-preview.pages.dev,https://zoption-site-preview.pages.dev",
        "SUPABASE_URL": "https://kkxzpjdsvcbveuuiyomk.supabase.co",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_yIO74YZrjUkxIZQrGm0lEQ_HgKKsyF5",
        "ASSISTANT_ENABLED": "true",
        "DEEPSEEK_MODEL": "deepseek-flash",
        "ASSISTANT_TIME_ZONE": "Asia/Manila",
        "ASSISTANT_PROVIDER_TIMEOUT_MS": "12000",
        "ASSISTANT_OVERALL_TIMEOUT_MS": "25000",
        "ASSISTANT_VOICE_ENABLED": "true",
        "ASSISTANT_VOICE_REVIEW_REQUIRED": "true",
        "ASSISTANT_VOICE_PROVIDER_TIMEOUT_MS": "30000",
        "RECEIPT_ENTRY_ENABLED": "true",
        "FAMILY_WORKSPACES_ENABLED": "false",
        "RECEIPT_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
        "RECEIPT_VISION_PROVIDER_TIMEOUT_MS": "30000",
        "FISH_AUDIO_TTS_MODEL": "s2.1-pro-free",
        "POSTHOG_AI_OBSERVABILITY_ENABLED": "true",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_AI_ENVIRONMENT": "preview",
        "WEB_APP_URL": "https://clarity-budget-preview.pages.dev",
        "PUBLIC_SITE_URL": "https://zoption-site-preview.pages.dev",
        "EMAIL_FROM": "hello@zoption.site",
        "BUG_REPORT_TO": "support@zoption.site",
        "PAYPAL_ENVIRONMENT": "production",
        "PAYPAL_BUDGET_MONTHLY_PLAN_ID": "P-02N35160H1697724CNLLBIVA",
        "PAYPAL_BUDGET_ANNUAL_PLAN_ID": "P-96G065804J598372UNLLBJ7Y",
        "PAYPAL_PRO_MONTHLY_PLAN_ID": "P-92K762218V133351PNLLBKUI",
        "PAYPAL_PRO_ANNUAL_PLAN_ID": "P-27K82609FR8802035NLLBLKQ",
        "PAYPAL_FAMILY_BUDGET_MONTHLY_PLAN_ID": "P-3EF68435PG594533GNLLBLZA",
        "PAYPAL_FAMILY_BUDGET_ANNUAL_PLAN_ID": "P-96P30687LJ852862UNLLBMHY",
        "PAYPAL_FAMILY_PRO_MONTHLY_PLAN_ID": "P-46B52861YN3915102NLLBMWY",
        "PAYPAL_FAMILY_PRO_ANNUAL_PLAN_ID": "P-3TM80216L7073562TNLLBNHA",
        "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
        "DODO_BUDGET_MONTHLY_PRODUCT_ID": "pdt_0Nq4nvsMUkPIsHVWNLZcJ",
        "DODO_BUDGET_ANNUAL_PRODUCT_ID": "pdt_0Nq4oTfGotnrSpRTySifi",
        "DODO_PRO_MONTHLY_PRODUCT_ID": "pdt_0Nq4oxtHvtmvTK9DXhJO6",
        "DODO_PRO_ANNUAL_PRODUCT_ID": "pdt_0Nq4pEQCtAtNmVCWYLqtn",
        "DODO_FAMILY_BUDGET_MONTHLY_PRODUCT_ID": "pdt_0Nq4pPqk0xBFJhkxokZ8R",
        "DODO_FAMILY_BUDGET_ANNUAL_PRODUCT_ID": "pdt_0Nq4pbT2uGlmaa8GvgULm",
        "DODO_FAMILY_PRO_MONTHLY_PRODUCT_ID": "pdt_0Nq4pdLR9t1aInjyYeS8m",
        "DODO_FAMILY_PRO_ANNUAL_PRODUCT_ID": "pdt_0Nq4pi5t5YmxUJ9kQe7z3",
        "MOBILE_SYNC_MINIMUM_APP_VERSION": "0.2.45",
        // Secret placeholder: OPS_EGRESS_TOKEN must be provisioned via
        // `wrangler secret put OPS_EGRESS_TOKEN --config wrangler.deploy.jsonc --env preview`
      },
    },
    "production": {
      "name": "budget-expense-api-production",
      "ai": {
        "binding": "AI",
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [
        {
          "pattern": "api.zoption.site",
          "custom_domain": true,
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "RATE_LIMIT", "class_name": "RateLimitDurableObject" }],
      },
      "r2_buckets": [
        { "binding": "AVATARS", "bucket_name": "zoption-avatars-production" },
        { "binding": "RECEIPTS", "bucket_name": "zoption-receipts-production" },
      ],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "budget-expense-jobs-production" }],
        "consumers": [
          {
            "queue": "budget-expense-jobs-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "budget-expense-production",
          "database_id": "87ecafae-d103-44a6-a236-ef6e39b55ad0",
          "migrations_dir": "../../db/migrations",
        },
      ],
      "vars": {
        "ALLOWED_ORIGINS": "https://app.zoption.site,https://zoption.site,https://www.zoption.site",
        "SUPABASE_URL": "https://tsgfhhmpkvzmcxzbdtic.supabase.co",
