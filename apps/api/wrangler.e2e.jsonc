{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budget-expense-api-e2e",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Browser tests exercise non-AI routes and must remain independent of Cloudflare credentials.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMIT", "class_name": "RateLimitDurableObject" }],
  },
  "migrations": [
    { "tag": "v1-rate-limit", "new_sqlite_classes": ["RateLimitDurableObject"] },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "budget-expense-jobs-e2e" }],
    "consumers": [
      {
        "queue": "budget-expense-jobs-e2e",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
      },
    ],
  },
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "zoption-avatars-e2e" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budget-expense-local",
      "database_id": "local-development",
      "migrations_dir": "../../db/migrations",
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "SUPABASE_URL": "http://127.0.0.1:54321",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_local-test-key",
    "SUPABASE_JWT_AUDIENCE": "authenticated",
    "WEB_APP_URL": "http://localhost:5173",
    "ASSISTANT_ENABLED": "false",
    "RECEIPT_ENTRY_ENABLED": "false",
    "PAYPAL_ENVIRONMENT": "sandbox",
  },
}
