{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budget-expense-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMIT", "class_name": "RateLimitDurableObject" }],
  },
  "migrations": [{ "tag": "v1-rate-limit", "new_sqlite_classes": ["RateLimitDurableObject"] }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "budget-expense-jobs-local" }],
    "consumers": [
      {
        "queue": "budget-expense-jobs-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
      },
    ],
  },
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "zoption-avatars-local" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budget-expense-local",
      "database_id": "local-development",
      "migrations_dir": "../../db/migrations",
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://zoption.site,https://www.zoption.site",
    "SUPABASE_URL": "http://127.0.0.1:54321",
    // Non-secret format-only key for local readiness and E2E startup.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_local-test-key",
    "SUPABASE_JWT_AUDIENCE": "authenticated",
    "WEB_APP_URL": "http://localhost:5173",
    // DEV_ACCESS_TOKEN_ENABLED is deliberately absent: the dummy-dev-access-token shortcut
    // defaults off. Set it to "true" in apps/api/.dev.vars (never in a deployed environment)
    // to accept that bearer from a loopback host during local development.

    "EMAIL_FROM": "hello@zoption.site",
    "BUG_REPORT_TO": "support@zoption.site",
    "ASSISTANT_ENABLED": "true",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "ASSISTANT_TIME_ZONE": "Asia/Manila",
    "ASSISTANT_PROVIDER_TIMEOUT_MS": "12000",
    "ASSISTANT_OVERALL_TIMEOUT_MS": "60000",
    "ASSISTANT_VOICE_ENABLED": "true",
    "ASSISTANT_VOICE_REVIEW_REQUIRED": "true",
    "ASSISTANT_VOICE_PROVIDER_TIMEOUT_MS": "30000",
    "RECEIPT_ENTRY_ENABLED": "true",
    "RECEIPT_VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "RECEIPT_VISION_PROVIDER_TIMEOUT_MS": "30000",
    "AI_ENTRY_PROVIDER_TIMEOUT_MS": "30000",
    "FISH_AUDIO_TTS_MODEL": "s2.1-pro-free",
    "POSTHOG_AI_OBSERVABILITY_ENABLED": "false",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "POSTHOG_AI_ENVIRONMENT": "local",
    "PAYPAL_ENVIRONMENT": "sandbox",
    "PAYPAL_PRO_MONTHLY_PLAN_ID": "REPLACE_WITH_PAYPAL_SANDBOX_MONTHLY_PLAN_ID",
    "PAYPAL_PRO_ANNUAL_PLAN_ID": "REPLACE_WITH_PAYPAL_SANDBOX_ANNUAL_PLAN_ID",
    "DODO_PAYMENTS_ENVIRONMENT": "test_mode",
    "DODO_PRO_MONTHLY_PRODUCT_ID": "REPLACE_WITH_DODO_TEST_MONTHLY_PRODUCT_ID",
    "DODO_PRO_ANNUAL_PRODUCT_ID": "REPLACE_WITH_DODO_TEST_ANNUAL_PRODUCT_ID",
  },
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *", "17 4 * * *"] },
}
