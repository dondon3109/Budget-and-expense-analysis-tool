{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budget-expense-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *", "17 4 * * *"] },
  "env": {
    "preview": {
      "name": "budget-expense-api-preview",
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["*/5 * * * *", "17 3 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "budget-expense-preview",
          "database_id": "REPLACE_WITH_PREVIEW_D1_ID",
          "migrations_dir": "../../db/migrations",
        },
      ],
      "vars": {
        "ALLOWED_ORIGINS": "https://REPLACE_WITH_PREVIEW_WEB_HOST",
        "SUPABASE_URL": "https://REPLACE_WITH_PREVIEW_SUPABASE_PROJECT_REF.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "REPLACE_WITH_PREVIEW_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "WEB_APP_URL": "https://REPLACE_WITH_PREVIEW_WEB_APP_HOST",
        "EMAIL_FROM": "REPLACE_WITH_VERIFIED_SENDER_EMAIL",
        "BUG_REPORT_TO": "support@zoption.site",
        "ASSISTANT_ENABLED": "true",
        "DEEPSEEK_MODEL": "deepseek-v4-flash",
        "ASSISTANT_TIME_ZONE": "Asia/Manila",
        "ASSISTANT_PROVIDER_TIMEOUT_MS": "12000",
        "ASSISTANT_OVERALL_TIMEOUT_MS": "60000",
        "ASSISTANT_VOICE_ENABLED": "true",
        "ASSISTANT_VOICE_REVIEW_REQUIRED": "true",
        "ASSISTANT_VOICE_PROVIDER_TIMEOUT_MS": "30000",
        "FISH_AUDIO_TTS_MODEL": "s2.1-pro-free",
        "STT_BRIDGE_URL": "wss://REPLACE_WITH_STT_BRIDGE_HOST/stream",
        "POSTHOG_AI_OBSERVABILITY_ENABLED": "false",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_AI_ENVIRONMENT": "preview",
        "PAYPAL_ENVIRONMENT": "production",
        "PAYPAL_PRO_MONTHLY_PLAN_ID": "REPLACE_WITH_PREVIEW_LIVE_PAYPAL_MONTHLY_PLAN_ID",
        "PAYPAL_PRO_ANNUAL_PLAN_ID": "REPLACE_WITH_PREVIEW_LIVE_PAYPAL_ANNUAL_PLAN_ID",
      },
    },
    "production": {
      "name": "budget-expense-api-production",
      "ai": { "binding": "AI" },
      "routes": [{ "pattern": "api.zoption.site", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "budget-expense-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "../../db/migrations",
        },
      ],
      "vars": {
        "ALLOWED_ORIGINS": "https://zoption.site,https://www.zoption.site",
        "SUPABASE_URL": "https://REPLACE_WITH_PRODUCTION_SUPABASE_PROJECT_REF.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "REPLACE_WITH_PRODUCTION_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "WEB_APP_URL": "https://zoption.site",
        "EMAIL_FROM": "REPLACE_WITH_VERIFIED_SENDER_EMAIL",
        "BUG_REPORT_TO": "support@zoption.site",
        "ASSISTANT_ENABLED": "true",
        "DEEPSEEK_MODEL": "deepseek-v4-flash",
        "ASSISTANT_TIME_ZONE": "Asia/Manila",
        "ASSISTANT_PROVIDER_TIMEOUT_MS": "12000",
        "ASSISTANT_OVERALL_TIMEOUT_MS": "60000",
        "ASSISTANT_VOICE_ENABLED": "true",
        "ASSISTANT_VOICE_REVIEW_REQUIRED": "false",
        "ASSISTANT_VOICE_PROVIDER_TIMEOUT_MS": "30000",
        "FISH_AUDIO_TTS_MODEL": "s2.1-pro-free",
        "STT_BRIDGE_URL": "wss://REPLACE_WITH_STT_BRIDGE_HOST/stream",
        "POSTHOG_AI_OBSERVABILITY_ENABLED": "false",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_AI_ENVIRONMENT": "production",
        "PAYPAL_ENVIRONMENT": "production",
        "PAYPAL_PRO_MONTHLY_PLAN_ID": "REPLACE_WITH_PRODUCTION_PAYPAL_MONTHLY_PLAN_ID",
        "PAYPAL_PRO_ANNUAL_PLAN_ID": "REPLACE_WITH_PRODUCTION_PAYPAL_ANNUAL_PLAN_ID",
      },
    },
  },
}
