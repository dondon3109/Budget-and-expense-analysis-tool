# Local physical-device development needs no override: Zoption Dev derives
# http://<expo-host>:8787 automatically. Set this only to pin a specific API.
EXPO_PUBLIC_API_URL=https://api.zoption.site
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Public PostHog identifiers for sanitized mobile crash telemetry. These values are embedded at build time.
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_token
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Public EAS project UUID. Development builds keep OTA disabled even when set.
EAS_PROJECT_ID=00000000-0000-4000-8000-000000000000
