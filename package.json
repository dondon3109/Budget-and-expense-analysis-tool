{
  "name": "zoption",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "lint": "eslint apps packages db e2e scripts playwright.config.ts release.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:prepare": "pnpm db:migrate:local",
    "test:e2e": "pnpm test:e2e:prepare && playwright test",
    "lighthouse": "lhci autorun",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "smoke:production": "node scripts/smoke-production.mjs",
    "paypal:sandbox:setup": "node --env-file=apps/api/.dev.vars scripts/setup-paypal-sandbox.mjs",
    "capture:screenshots": "node scripts/capture-portfolio.mjs",
    "ads:studio": "pnpm --filter @zoption/ads studio",
    "ads:render:feature": "pnpm --filter @zoption/ads render:feature",
    "ads:render:problem": "pnpm --filter @zoption/ads render:problem",
    "ads:render:showcase": "pnpm --filter @zoption/ads render:showcase",
    "ads:render:combined": "pnpm --filter @zoption/ads render:combined",
    "ads:render:all": "pnpm --filter @zoption/ads render:all",
    "mobile:start": "node scripts/ensure-adb-reverse.mjs && pnpm --filter @zoption/mobile start",
    "mobile:android": "node scripts/ensure-adb-reverse.mjs && pnpm --filter @zoption/mobile android",
    "mobile:android:rebuild": "node scripts/ensure-adb-reverse.mjs && pnpm --filter @zoption/mobile android:rebuild",
    "mobile:ios": "pnpm --filter @zoption/mobile ios",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "pnpm --filter @zoption/api exec wrangler d1 migrations apply budget-expense-local --local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "semantic-release": "^25.0.9",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
