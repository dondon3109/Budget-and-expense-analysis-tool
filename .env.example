# Optional browser-facing API override. Leave blank in local development to use the Vite proxy.
# Production defaults to https://api.zoption.site via apps/web/.env.production.
VITE_API_URL=

# Public Supabase browser configuration (Project Settings > API).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SB_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Optional public analytics identifiers. These are browser-visible IDs, not account API secrets.
VITE_GA_MEASUREMENT_ID=
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# PayPal approval is initiated by the Worker and redirects the browser to PayPal. No public
# payment-provider browser configuration is required.

# Comma-separated origins accepted by the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://zoption.site,https://www.zoption.site

# Worker-side JWT verification. This URL must match VITE_SUPABASE_URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Worker-side non-secret key for the account-deletion reauthentication check.
SUPABASE_PUBLISHABLE_KEY=YOUR_SB_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Worker-only transactional invitation email configuration delivered through Resend. Verify the
# sender domain in Resend and store RESEND_API_KEY as a Worker secret (`wrangler secret put`) or in
# ignored apps/api/.dev.vars. No Cloudflare send_email binding is required.
WEB_APP_URL=https://zoption.site
EMAIL_FROM=hello@zoption.site
# Store SUPABASE_SERVICE_ROLE_KEY with `wrangler secret put`; never commit or expose it to Vite.

# Operator-enabled Android crash telemetry (posthog-react-native), read at build time by
# apps/mobile. This is NOT user opt-in: every APK/OTA built with a key reports sanitized
# crash summaries. Leave blank to ship telemetry fully inert; no key means no network calls.
# CI embeds this from the EXPO_PUBLIC_POSTHOG_KEY repository secret.
EXPO_PUBLIC_POSTHOG_KEY=
# Optional regional host override; defaults to https://us.i.posthog.com. CI embeds this from
# the EXPO_PUBLIC_POSTHOG_HOST repository variable.
EXPO_PUBLIC_POSTHOG_HOST=
# Build-time hard kill switch. CI passes the same-named repository variable into every
# APK/OTA build, so setting it to 1 disables telemetry construction in builds made while
# it is set; devices already installed only pick that up after receiving such an update.
# To stop reporting without shipping a new bundle, disable the PostHog feature flag
# `crash-telemetry-enabled`: each app evaluates it on startup and fails closed whenever the
# flag is absent, unresolved, or false. An already-running process observes the change on
# its next SDK flag refresh or app restart.
EXPO_PUBLIC_TELEMETRY_DISABLED=
