# Optional browser-facing API override. Leave blank in local development to use the Vite proxy.
# Production defaults to https://api.zoption.site via apps/web/.env.production.
VITE_API_URL=

# Public Supabase browser configuration (Project Settings > API).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Paddle.js values are public but must be environment-specific. Use a test_ token for Sandbox.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=

# Comma-separated origins accepted by the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://zoption.site,https://www.zoption.site

# Worker-side JWT verification. This URL must match VITE_SUPABASE_URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Worker-side non-secret key for the account-deletion reauthentication check.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Worker-only transactional invitation email configuration. The sender domain must be onboarded for
# Cloudflare Email Service and the Worker must have an EMAIL send_email binding.
WEB_APP_URL=https://zoption.site
EMAIL_FROM=hello@zoption.site
# Store SUPABASE_SERVICE_ROLE_KEY with `wrangler secret put`; never commit or expose it to Vite.
