playwright-report/
test-results/
tmp/
_tmp_*

# Scratch directory the bugfix workflow builds its draft in. It sits inside the checkout while
# that job runs, so it must stay out of both the generated patch and the pull request branch.
bugfix-artifact/
.lighthouseci/
.DS_Store
*.log
*.tsbuildinfo
*.swp
~$*
__pycache__/
*.pyc

# Android build output and release-signing secrets
*.jks
*.keystore
*.p12
**/keystore.properties
**/signing.properties
*.apk
*.aab
*.idsig
.worktrees/

# Client build handoff for prerender (build-time only, outside the deployed dist)
apps/web/.zoption-build/

# Local-only agent settings. Shared project agent config stays tracked.
.claude/settings.local.json

# Credential material that must never be committed
*.pem
*.key
.npmrc
.netrc

